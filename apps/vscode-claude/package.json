{
  "name": "claude-code-rtl",
  "displayName": "SmartRTL for Claude Code",
  "description": "Fixes right-to-left text (Urdu, Arabic, Hebrew, Persian) in the Claude Code panel. ⚠ Uninstalling does not turn it off — use the ⚙ menu first.",
  "version": "0.5.5",
  "publisher": "smartrtl",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1F2338",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "rtl",
    "bidi",
    "arabic",
    "hebrew",
    "urdu",
    "persian",
    "claude",
    "claude-code",
    "i18n"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/naveed-toro/smartrtl.git"
  },
  "homepage": "https://github.com/naveed-toro/smartrtl#readme",
  "bugs": {
    "url": "https://github.com/naveed-toro/smartrtl/issues"
  },
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "contributes": {
    "commands": [
      {
        "command": "smartrtl.turnOn",
        "title": "Turn on the right-to-left fix",
        "category": "SmartRTL"
      },
      {
        "command": "smartrtl.turnOff",
        "title": "Turn off the right-to-left fix",
        "category": "SmartRTL"
      },
      {
        "command": "smartrtl.status",
        "title": "Show status",
        "category": "SmartRTL"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "smartrtl.turnOn",
          "when": "!smartrtl.active"
        },
        {
          "command": "smartrtl.turnOff",
          "when": "smartrtl.active"
        }
      ],
      "extension/context": [
        {
          "command": "smartrtl.turnOn",
          "when": "extension == smartrtl.claude-code-rtl && !smartrtl.active"
        },
        {
          "command": "smartrtl.turnOff",
          "when": "extension == smartrtl.claude-code-rtl && smartrtl.active"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "vscode:uninstall": "node ./src/uninstall.js",
    "build": "node build/bundle-payload.js",
    "test": "npm run build && node --test test/",
    "review": "npm run build && node --test test/the-line.test.js test/status-bar.test.js test/startup-cost.test.js test/rendering.test.js test/claude-shape.test.js test/real-bundle.test.js test/real-webview.test.js test/composer-survival.test.js test/sent-survival.test.js test/pinned-message.test.js test/independent-lamps.test.js"
  },
  "devDependencies": {
    "playwright": "^1.56.0"
  }
}
