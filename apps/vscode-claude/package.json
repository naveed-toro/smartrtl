{
  "name": "claude-code-rtl",
  "displayName": "SmartRTL for Claude Code",
  "description": "Fixes right-to-left text (Urdu, Arabic, Hebrew, Persian) in the Claude Code panel.",
  "version": "0.10.0",
  "publisher": "smartrtl",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1F2338",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "rtl",
    "bidi",
    "arabic",
    "hebrew",
    "urdu",
    "persian",
    "claude",
    "claude-code",
    "i18n"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/naveed-toro/smartrtl.git"
  },
  "homepage": "https://github.com/naveed-toro/smartrtl#readme",
  "bugs": {
    "url": "https://github.com/naveed-toro/smartrtl/issues"
  },
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "vscode:prepublish": "npm run build",
    "vscode:uninstall": "node ./src/uninstall.js",
    "build": "node build/bundle-payload.js",
    "test": "npm run build && node --test test/",
    "review": "npm run build && node --test test/only-the-formula.test.js test/startup-cost.test.js ../../packages/core/test/direction.test.js ../../packages/core/test/frozen.test.js"
  },
  "devDependencies": {
    "playwright": "^1.56.0"
  }
}
